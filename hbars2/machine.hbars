{{!-- machine.hbars --}}
{{!--
  A Handlebars template that exports a JSON-based description of your traffic & pedestrian
  state machine, referencing "edges" for transitions. It ensures no trailing commas.

  Inline helpers: edgesForSource, groupTransitions, objectHasKeys
--}}

{{!-- *inline helper edgesForSource
function (root, sourceId) {
  if (!root || !root.edges) return [];
  return root.edges.filter(e => e.source === sourceId);
}
--}}

{{!-- *inline helper groupTransitions
function (edges) {
  const grouped = { named: {}, after: {} };
  edges.forEach(edge => {
    const eData = edge.data && edge.data.eventTypeData ? edge.data.eventTypeData : {};
    const evtType = eData.type || "";
    const evtName = eData.eventType || "";
    const delay = eData.delay;

    if (evtType === "after" && delay) {
      if (!grouped.after[delay]) grouped.after[delay] = [];
      grouped.after[delay].push(edge);
    } else {
      if (!grouped.named[evtName]) grouped.named[evtName] = [];
      grouped.named[evtName].push(edge);
    }
  });
  return grouped;
}
--}}

{{!-- *inline helper objectHasKeys
function (obj) {
  return obj && Object.keys(obj).length > 0;
}
--}}

{
  "id": "{{rootNode.data.key}}",
  "type": "{{rootNode.data.type}}",
  "description": "{{rootNode.data.description}}",
  "context": {{{json context}}},

  "states": {
    {{!-- Loop top-level states (trafficOps, pedestrianOps) --}}
    {{#each rootNode.nodes}}
    "{{data.key}}": {
      "id": "{{id}}"
      {{#if data.description}},
      "description": "{{data.description}}"{{/if}}
      {{#if data.initial}},
      "initial": "{{data.initial}}"{{/if}}
      {{#if data.type}},
      "type": "{{data.type}}"{{/if}}
      {{#if data.history}},
      "history": "{{data.history}}"{{/if}}

      {{!-- If there's an invoked service array --}}
      {{#if data.invoke.length}},
      "invoke": [
        {{#each data.invoke}}
        {
          "id": "{{id}}",
          "src": "{{src}}"
        }{{#unless @last}},{{/unless}}
        {{/each}}
      ]{{/if}}

      {{!-- entry actions --}}
      {{#if data.entry.length}},
      "entry": [
        {{#each data.entry}}
        "{{action.type}}"{{#unless @last}},{{/unless}}
        {{/each}}
      ]{{/if}}

      {{!-- exit actions --}}
      {{#if data.exit.length}},
      "exit": [
        {{#each data.exit}}
        "{{action.type}}"{{#unless @last}},{{/unless}}
        {{/each}}
      ]{{/if}},


      "states": {
        {{!-- Child states of trafficOps, for example --}}
        {{#each nodes}}
        "{{data.key}}": {
          {{#if data.description}}
          "description": "{{data.description}}"{{/if}}
          {{#if data.type}}
          {{#if data.description}},{{/if}}
          "type": "{{data.type}}"{{/if}}
          {{#if data.history}}
          {{#if (or data.description data.type)}},{{/if}}
          "history": "{{data.history}}"{{/if}}

          {{#if data.entry.length}}
          {{#if (or data.description data.type data.history)}},{{/if}}
          "entry": [
            {{#each data.entry}}
            "{{action.type}}"{{#unless @last}},{{/unless}}
            {{/each}}
          ]{{/if}}

          {{#if data.exit.length}}
          {{#if (or data.description data.type data.history data.entry.length)}},{{/if}}
          "exit": [
            {{#each data.exit}}
            "{{action.type}}"{{#unless @last}},{{/unless}}
            {{/each}}
          ]{{/if}}

          {{!-- Gather sub-state transitions --}}
          {{#with (edgesForSource ../../../.. id) as |childEdges|}}
            {{#with (groupTransitions childEdges) as |grouped|}}
              {{!-- Named transitions => "on": {...} --}}
              {{#if (objectHasKeys grouped.named)}}
              {{#if (or data.description data.type data.history data.entry.length data.exit.length)}},{{/if}}
              "on": {
                {{#each grouped.named}}
                "{{@key}}":
                  {{#if this.length}}
                  [
                    {{#each this}}
                    {
                      {{#if this.data.guard}}
                      "guard": {
                        "type": "{{this.data.guard.type}}"
                      },
                      {{/if}}
                      {{#if this.data.actions.length}}
                      "actions": [
                        {{#each this.data.actions}}
                        {
                          "type": "{{this.action.type}}"
                          {{#if this.action.params}}, "params": {{{json this.action.params}}}{{/if}}
                        }{{#unless @last}},{{/unless}}
                        {{/each}}
                      ],
                      {{/if}}
                      "target": "{{target}}"
                    }{{#unless @last}},{{/unless}}
                    {{/each}}
                  ]
                  {{else}}
                  {
                    {{#if this.data.guard}}
                    "guard": {
                      "type": "{{this.data.guard.type}}"
                    },
                    {{/if}}
                    {{#if this.data.actions.length}}
                    "actions": [
                      {{#each this.data.actions}}
                      {
                        "type": "{{this.action.type}}"
                        {{#if this.action.params}}, "params": {{{json this.action.params}}}{{/if}}
                      }{{#unless @last}},{{/unless}}
                      {{/each}}
                    ],
                    {{/if}}
                    "target": "{{this.target}}"
                  }
                  {{/if}}
                {{#unless @last}},{{/unless}}
                {{/each}}
              }{{/if}}

              {{!-- Delayed transitions => "after": {...} --}}
              {{#if (objectHasKeys grouped.after)}}
              {{#if (or data.description data.type data.history data.entry.length data.exit.length (objectHasKeys grouped.named))}},{{/if}}
              "after": {
                {{#each grouped.after}}
                "{{@key}}":
                  {{#if this.length}}
                  [
                    {{#each this}}
                    {
                      {{#if this.data.guard}}
                      "guard": {
                        "type": "{{this.data.guard.type}}"
                      },
                      {{/if}}
                      {{#if this.data.actions.length}}
                      "actions": [
                        {{#each this.data.actions}}
                        {
                          "type": "{{this.action.type}}"
                          {{#if this.action.params}}, "params": {{{json this.action.params}}}{{/if}}
                        }{{#unless @last}},{{/unless}}
                        {{/each}}
                      ],
                      {{/if}}
                      "target": "{{target}}"
                    }{{#unless @last}},{{/unless}}
                    {{/each}}
                  ]
                  {{else}}
                  {
                    {{#if this.data.guard}}
                    "guard": {
                      "type": "{{this.data.guard.type}}"
                    },
                    {{/if}}
                    {{#if this.data.actions.length}}
                    "actions": [
                      {{#each this.data.actions}}
                      {
                        "type": "{{this.action.type}}"
                        {{#if this.action.params}}, "params": {{{json this.action.params}}}{{/if}}
                      }{{#unless @last}},{{/unless}}
                      {{/each}}
                    ],
                    {{/if}}
                    "target": "{{this.target}}"
                  }
                  {{/if}}
                {{#unless @last}},{{/unless}}
                {{/each}}
              }
              {{/if}}
            {{/with}}
          {{/with}}
        }{{#unless @last}},{{/unless}}
        {{/each}}
      }

      {{!-- Parent-level transitions --}}
      {{#with (edgesForSource ../../.. id) as |parentEdges|}}
        {{#with (groupTransitions parentEdges) as |grouped|}}
          {{#if (objectHasKeys grouped.named)}},
          "on": {
            {{#each grouped.named}}
            "{{@key}}":
              {{#if this.length}}
              [
                {{#each this}}
                {
                  {{#if this.data.guard}}
                  "guard": {
                    "type": "{{this.data.guard.type}}"
                  },
                  {{/if}}
                  {{#if this.data.actions.length}}
                  "actions": [
                    {{#each this.data.actions}}
                    {
                      "type": "{{this.action.type}}"
                      {{#if this.action.params}}, "params": {{{json this.action.params}}}{{/if}}
                    }{{#unless @last}},{{/unless}}
                    {{/each}}
                  ],
                  {{/if}}
                  "target": "{{target}}"
                }{{#unless @last}},{{/unless}}
                {{/each}}
              ]
              {{else}}
              {
                {{#if this.data.guard}}
                "guard": {
                  "type": "{{this.data.guard.type}}"
                },
                {{/if}}
                {{#if this.data.actions.length}}
                "actions": [
                  {{#each this.data.actions}}
                  {
                    "type": "{{this.action.type}}"
                    {{#if this.action.params}}, "params": {{{json this.action.params}}}{{/if}}
                  }{{#unless @last}},{{/unless}}
                  {{/each}}
                ],
                {{/if}}
                "target": "{{this.target}}"
              }
              {{/if}}
            {{#unless @last}},{{/unless}}
            {{/each}}
          }{{/if}}

          {{#if (objectHasKeys grouped.after)}}
          {{#if (objectHasKeys grouped.named)}},{{/if}}
          "after": {
            {{#each grouped.after}}
            "{{@key}}":
              {{#if this.length}}
              [
                {{#each this}}
                {
                  {{#if this.data.guard}}
                  "guard": {
                    "type": "{{this.data.guard.type}}"
                  },
                  {{/if}}
                  {{#if this.data.actions.length}}
                  "actions": [
                    {{#each this.data.actions}}
                    {
                      "type": "{{this.action.type}}"
                      {{#if this.action.params}}, "params": {{{json this.action.params}}}{{/if}}
                    }{{#unless @last}},{{/unless}}
                    {{/each}}
                  ],
                  {{/if}}
                  "target": "{{target}}"
                }{{#unless @last}},{{/unless}}
                {{/each}}
              ]
              {{else}}
              {
                {{#if this.data.guard}}
                "guard": {
                  "type": "{{this.data.guard.type}}"
                },
                {{/if}}
                {{#if this.data.actions.length}}
                "actions": [
                  {{#each this.data.actions}}
                  {
                    "type": "{{this.action.type}}"
                    {{#if this.action.params}}, "params": {{{json this.action.params}}}{{/if}}
                  }{{#unless @last}},{{/unless}}
                  {{/each}}
                ],
                {{/if}}
                "target": "{{this.target}}"
              }
              {{/if}}
            {{#unless @last}},{{/unless}}
            {{/each}}
          }
          {{/if}}
        {{/with}}
      {{/with}}

    }{{#unless @last}},{{/unless}}
    {{/each}}
  },

  "implementations": {
    "guards": {
      {{#each implementations.guards}}
      "{{@key}}": {
        "id": "{{this.id}}",
        "name": "{{this.name}}"
      }{{#unless @last}},{{/unless}}
      {{/each}}
    },
    "actions": {
      {{#each implementations.actions}}
      "{{@key}}": {
        "id": "{{this.id}}",
        "name": "{{this.name}}",
        "schema": {{{json this.schema}}}
      }{{#unless @last}},{{/unless}}
      {{/each}}
    },
    "actors": {
      {{#each implementations.actors}}
      "{{@key}}": {
        "id": "{{this.id}}",
        "name": "{{this.name}}",
        "input": {{{json this.input}}},
        "output": {{{json this.output}}}
      }{{#unless @last}},{{/unless}}
      {{/each}}
    }
  },

  "schemas": {
    "events": {
      {{#each schemas.events}}
      "{{@key}}": {
        "properties": {
          {{#each this.properties}}
          "{{@key}}": "{{this}}"{{#unless @last}},{{/unless}}
          {{/each}}
        }
      }{{#unless @last}},{{/unless}}
      {{/each}}
    }
  }
}
