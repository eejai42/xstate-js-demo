{{!-- README.hbars --}}
{{!--
  A Handlebars template that generates a Markdown-style README from a machine JSON.
  It uses "inline helpers" that your environment will parse, similar to machine.hbars.
--}}

{{!-- *inline helper objectHasKeys
function (obj) {
  return obj && Object.keys(obj).length > 0;
}
--}}

{{!-- *inline helper toAnchor
function(str) {
  // Remove punctuation/spaces/dots/apostrophes/hyphens for GitHub-style anchors
  return str
    .replace(/[.]/g, "")
    .replace(/['"]/g, "")
    .replace(/ /g, "")
    .replace(/-/g, "")
    .toLowerCase();
}
--}}

{{!-- 
  *inline helper buildREADME 
  Recursively walks the machine to produce the entire README as a single string.
  The "machine" param is the entire object.
  The "stateId" param is the current state's ID (like "expanded-traffic-system.trafficOps.green").
  The "stateObj" param is that state's JSON (which may have sub-states).
  The "indentLevel" param helps produce the right level of "##" headings.
--}}

{{!-- *inline helper buildREADME
function (machine, stateId, stateObj, indentLevel) {
  // We'll build a markdown chunk for the current state, then recurse for child states
  // Return a string that the template can place inline
}
--}}

{{#*inline "buildREADMECode"}}
{{!-- This is the "body" of the buildREADME function --}}

  // Produce the heading lines. We'll use "##" repeated indentLevel times
  let headingHashes = "#".repeat(indentLevel);
  let md = "";

  // If we have an ID, let's print that
  if (stateId) {
    md += `\n${headingHashes} ${stateId}\n`;
  }

  // If there's a description
  if (stateObj.description) {
    md += `> ${stateObj.description}\n\n`;
  }

  // If there's an invoked service
  if (Array.isArray(stateObj.invoke) && stateObj.invoke.length > 0) {
    let inv = stateObj.invoke[0];
    md += `**Invoke** from source \`${inv.src}\` (ID: \`${inv.id}\`) \n\n`;
  }

  // If there's entry actions
  if (Array.isArray(stateObj.entry) && stateObj.entry.length > 0) {
    md += `**On entry:**\n`;
    stateObj.entry.forEach(actionName => {
      md += `- **Do** \`${actionName}\` \n`;
    });
    md += `\n`;
  }

  // If there's "on" transitions
  if (stateObj.on) {
    // stateObj.on is an object: { eventName: [ { target, guard, actions...}, ... ] }
    for (let eventName of Object.keys(stateObj.on)) {
      let transitions = stateObj.on[eventName];
      transitions.forEach(t => {
        md += `**On** \`${eventName}\``;
        if (t.guard && t.guard.type) {
          md += ` if \`${t.guard.type}\``;
        }
        md += `:\n\n`;
        // If there's actions
        if (Array.isArray(t.actions) && t.actions.length > 0) {
          t.actions.forEach(act => {
            md += `- **Do** \`${act.type}\``;
            // If there's params
            if (act.params && Object.keys(act.params).length > 0) {
              md += ` with params: \n`;
              for (let [pKey, pVal] of Object.entries(act.params)) {
                md += `  - \`${pKey}\`: \`${pVal}\`\n`;
              }
            } else {
              md += ` \n`;
            }
          });
        }
        // Then the transition
        let anchor = toAnchor(t.target);
        md += `- **Transition** to [${t.target}](#${anchor})\n\n`;
      });
    }
  }

  // If there's "after" transitions
  if (stateObj.after) {
    // e.g. { TRANSITION_DELAY: [ { actions: [...], target: "..." }, ... ] }
    for (let delayName of Object.keys(stateObj.after)) {
      let transitions = stateObj.after[delayName];
      transitions.forEach(t => {
        md += `**On** \`xstate.after(${delayName})#${stateId}\``;
        if (t.guard && t.guard.type) {
          md += ` if \`${t.guard.type}\``;
        }
        md += `:\n\n`;
        // If there's actions
        if (Array.isArray(t.actions) && t.actions.length > 0) {
          t.actions.forEach(act => {
            md += `- **Do** \`${act.type}\``;
            // If there's params
            if (act.params && Object.keys(act.params).length > 0) {
              md += ` with params: \n`;
              for (let [pKey, pVal] of Object.entries(act.params)) {
                md += `  - \`${pKey}\`: \`${pVal}\`\n`;
              }
            } else {
              md += ` \n`;
            }
          });
        }
        // Then the transition
        let anchor = toAnchor(t.target);
        md += `- **Transition** to [${t.target}](#${anchor})\n\n`;
      });
    }
  }

  // If there's exit actions
  if (Array.isArray(stateObj.exit) && stateObj.exit.length > 0) {
    md += `**On exit:**\n`;
    stateObj.exit.forEach(actionName => {
      md += `- **Do** \`${actionName}\` \n`;
    });
    md += `\n`;
  }

  // Now, if there's child states
  if (stateObj.states && Object.keys(stateObj.states).length > 0) {
    // Recurse
    for (let [subKey, subStateObj] of Object.entries(stateObj.states)) {
      let subId = stateId ? stateId + "." + subKey : subKey;
      md += buildREADME(machine, subId, subStateObj, indentLevel);
    }
  }

  return md;
}}
{{/inline}}

{{!-- 
  We reference "machine" below because "this" is the entire data object.
  We'll produce a top-level heading for the machine, then walk each top-level state.
--}}

{{!-- *inline helper buildFullReadme
function (machine) {
  // We'll create the top-level readme for the root machine, 
  // then recursively build for each top-level state
}
--}}

## {{id}}
> {{description}}

{{#each states as |topStateObj topStateKey|}}
{{buildREADME ../ this topStateKey topStateObj (concat ../id "." topStateKey) 2}}
{{/each}}
